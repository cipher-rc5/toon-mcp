# toon-mcp environment variables — copy to .env and adjust as needed.
# All values below are defaults; unset variables fall back to these values.

# Encode only if toon_output_bytes < input_bytes * threshold (0.0–1.0).
# 0.85 means output must be at most 85% of input (at least 15% savings).
TOON_COMPRESSION_THRESHOLD=0.85

# Skip classification when input is below this byte count.
TOON_MIN_BYTES=256

# Reject inputs larger than this byte count without processing.
# Prevents unbounded memory allocation. Default: 10 MiB.
TOON_MAX_INPUT_BYTES=10485760

# Enable TOON key folding for FoldChain shapes (true/false).
TOON_KEY_FOLDING=true

# Array delimiter used in TOON output (comma, tab, or pipe).
TOON_DELIMITER=comma

# Minimum array length for Tabular shape classification.
TOON_TABULAR_MIN_ROWS=3

# Minimum chain depth for FoldChain classification.
TOON_FOLD_MIN_DEPTH=3

# Minimum array length for PrimitiveArray classification.
TOON_PRIMITIVE_ARRAY_MIN=5

# Per-call pipeline timeout in milliseconds. Calls exceeding this duration
# return an error rather than blocking indefinitely. Default: 30 seconds.
TOON_PIPELINE_TIMEOUT_MS=30000

# Maximum number of concurrent blocking pipeline calls.
# Additional calls wait up to TOON_PIPELINE_TIMEOUT_MS for a permit, then return
# a server-busy error. Lower this on small/shared hosts; raise only with CPU and
# memory headroom.
TOON_MAX_CONCURRENT_CALLS=8

# Set false when CSV/TSV data contains identifiers, postal codes, phone numbers,
# or leading-zero values that must remain strings.
TOON_CSV_NUMERIC_COERCION=true

# Set false to disable structured event logging (use NoopSink).
TOON_LOG_ENABLED=true

# Directory for hive-partitioned JSONL log files.
# Must be an absolute path when used from Claude Desktop.
# Example: /Users/you/projects/toon-mcp/data/logs
TOON_LOG_DIR=data/logs

# Periodic flush interval in seconds.
TOON_LOG_FLUSH_INTERVAL_SECS=300

# mpsc channel capacity (backpressure threshold).
TOON_LOG_BUFFER_SIZE=1000

# tracing filter string (e.g. info, debug, toon_mcp_server=debug).
TOON_LOG_LEVEL=info

# Tag log rows by client ("opencode" | "claude-desktop" | leave empty).
TOON_CLIENT_HINT=
