# toon-mcp environment variables — copy to .env and adjust as needed.
# All values below are defaults; unset variables fall back to these values.

# Encode only if toon_len < input_len * threshold (0.0–1.0)
TOON_COMPRESSION_THRESHOLD=0.85

# Skip classification when input is below this byte count
TOON_MIN_BYTES=256

# Enable TOON key folding for FoldChain shapes (true/false)
TOON_KEY_FOLDING=true

# Array delimiter used in TOON output (comma, tab, or pipe)
TOON_DELIMITER=comma

# Minimum array length for Tabular shape classification
TOON_TABULAR_MIN_ROWS=3

# Minimum chain depth for FoldChain classification
TOON_FOLD_MIN_DEPTH=3

# Minimum array length for PrimitiveArray classification
TOON_PRIMITIVE_ARRAY_MIN=5

# Set false to disable DuckDB logging (use NoopSink)
TOON_LOG_ENABLED=true

# DuckDB file path (relative to working directory for opencode,
# MUST be absolute for Claude Desktop)
TOON_LOG_DB_PATH=data/interactions.duckdb

# Parquet export root (relative for opencode, absolute for Claude Desktop)
TOON_LOG_PARQUET_DIR=data/parquet

# Periodic Parquet flush interval in seconds
TOON_LOG_FLUSH_INTERVAL_SECS=300

# mpsc channel capacity (backpressure threshold)
TOON_LOG_BUFFER_SIZE=1000

# tracing filter string (e.g. info, debug, toon_mcp_server=debug)
TOON_LOG_LEVEL=info

# Tag log rows by client ("opencode" | "claude-desktop" | leave empty)
TOON_CLIENT_HINT=
