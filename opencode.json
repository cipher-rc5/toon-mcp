{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "azure": {
      "npm": "@ai-sdk/openai",
      "name": "Azure OpenAI",
      "options": {
        "apiKey": "{env:AZURE_COGNITIVE_SERVICES_API_KEY}",
        "baseURL": "https://c0217-mow3o9wg-eastus2.cognitiveservices.azure.com/openai/v1",
        "headers": {
          "api-key": "{env:AZURE_COGNITIVE_SERVICES_API_KEY}"
        },
        "defaultQuery": {
          "api-version": "preview"
        }
      },
      "models": {
        "gpt-5.5": {
          "name": "Azure GPT-5.5",
          "limit": {
            "context": 400000,
            "output": 16384
          }
        }
      }
    }
  },
  "model": "azure/gpt-5.5",
  "mcp": {
    "toon": {
      "type": "local",
      "command": [
        "./target/release/toon-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "TOON_COMPRESSION_THRESHOLD": "0.85",
        "TOON_MIN_BYTES": "256",
        "TOON_MAX_INPUT_BYTES": "10485760",
        "TOON_KEY_FOLDING": "true",
        "TOON_DELIMITER": "comma",
        "TOON_LOG_ENABLED": "true",
        "TOON_LOG_DIR": "data/logs",
        "TOON_LOG_FLUSH_INTERVAL_SECS": "300",
        "TOON_LOG_BUFFER_SIZE": "1000",
        "TOON_LOG_LEVEL": "info",
        "TOON_CLIENT_HINT": "opencode",
        "TOON_PIPELINE_TIMEOUT_MS": "30000"
      }
    }
  }
}
