# Copy this file to `.env.eval` (gitignored) and fill in your local values.
# `serve.sh` and the `just serve*` recipes source it automatically.

# Absolute path to your .gguf model (required).
TOON_EVAL_MODEL_PATH=/path/to/your-model.gguf

# Server bind + client connection.
TOON_EVAL_HOST=127.0.0.1
TOON_EVAL_PORT=8080

# Context window. Raise (e.g. 32768) if your model supports it.
TOON_EVAL_CTX_SIZE=8192

# GPU layers to offload (Metal/CUDA). 99 = all; lower if VRAM-limited.
TOON_EVAL_NGL=99

# Optional: override the binary name/path, or append extra llama-server flags.
# TOON_EVAL_LLAMA_BIN=llama-server
# TOON_EVAL_EXTRA_ARGS=--flash-attn --parallel 2

# Model name the eval client sends in chat requests, and the base URL it calls.
# Set the base URL to match HOST/PORT above if you change them.
TOON_EVAL_MODEL=your-model
TOON_EVAL_BASE_URL=http://127.0.0.1:8080
